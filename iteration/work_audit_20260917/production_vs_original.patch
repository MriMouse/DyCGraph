+            index_t FindSegmentForVertexHost(index_t vertex) const {
+                index_t lo = 0;
+                index_t hi = FLAGS_SEGMENT;
+                while (lo < hi) {
+                    const index_t mid = lo + (hi - lo) / 2;
+                    if (vertex < m_groute_context->seg_enode[mid]) {
+                        hi = mid;
+                    } else {
+                        lo = mid + 1;
+                    }
+                }
+                return lo;
+            }
