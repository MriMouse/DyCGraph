+        cudaFree(d_offsets); cudaFree(d_sources); cudaFree(d_vertices); cudaFree(d_owned); cudaFree(d_values); cudaFree(d_parents); cudaFree(d_ids); cudaFree(d_changed); return elapsed;
+    }
+};
+
+int Main(int argc, char **argv) {
